# Optional fallback when RSS produces too few Manchester United matches.
NEWSAPI_KEY=

# Optional public-data collector for the configured 15-account X watchlist.
# Use an authorized third-party JSON provider or a lawful public RSS/Atom source.
# The collector does not bypass login, CAPTCHA, rate limits, or anti-bot controls.
X_PROVIDER=
X_PROVIDER_BASE_URL=
X_PROVIDER_API_KEY=
X_PROVIDER_RECENT_PATH=/users/{username}/posts
X_PUBLIC_FEED_URL_TEMPLATE=

# Mock ingestion is test-only and remains disabled unless explicitly enabled.
X_ALLOW_MOCK_INGEST=false
X_COLLECTION_DEFAULT_INTERVAL=30
X_MAX_POSTS_PER_COLLECTION=20
X_MAX_ACCOUNTS_PER_RUN=5
X_REQUEST_TIMEOUT_SECONDS=20

# Optional Anthropic key for grounded Thai rewrites, angles, and daily digests.
ANTHROPIC_API_KEY=

# Override only when your Anthropic account uses a different Sonnet model ID.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional YouTube Data API v3 key for live @FootballGeniusAG channel analytics.
# Without it, the GOG profile and social links still work, but metrics stay clearly unavailable.
YOUTUBE_API_KEY=

# Optional bearer secret for GET /api/ingest cron calls. POST remains available for the newsroom sync control.
CRON_SECRET=
