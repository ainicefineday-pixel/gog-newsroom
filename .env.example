# Optional fallback when RSS produces too few Manchester United matches.
NEWSAPI_KEY=

# Optional X API v2 application bearer token. Without it, X ingestion is skipped.
X_BEARER_TOKEN=

# Optional Anthropic key for grounded Thai rewrites, angles, and daily digests.
ANTHROPIC_API_KEY=

# Override only when your Anthropic account uses a different Sonnet model ID.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional bearer secret for GET /api/ingest cron calls. POST remains available for the newsroom sync control.
CRON_SECRET=
